{
    "name": "russellramey/laravel-jsonconfig",
    "description": "Laravel trait for managing model attributes stored as JSON in a single database column.",
    "type": "library",
    "license": "MIT",
    "version": "0.1.0",
    "authors": [
        {
            "name": "Russell Ramey",
            "homepage": "https://github.com/russellramey"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/database": "^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "RussellRamey\\JsonConfig\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RussellRamey\\JsonConfig\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "RussellRamey\\JsonConfig\\JsonConfigServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
